<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jwala</AssemblyName>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Version>0.3.4</Version>
    <Product>Jwala Amp Sim</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\*.*" LogicalName="%(Filename)%(Extension)" />
    <!-- the UI fonts (UI/Fonts.cs) -->
    <EmbeddedResource Include="..\..\assets\fonts\*.ttf" LogicalName="%(Filename)%(Extension)" />
    <!-- the startup splash's logo (UI/Splash.cs) -->
    <EmbeddedResource Include="..\..\assets\appicon\jwala_512.png" LogicalName="jwala_512.png" />
  </ItemGroup>

</Project>
